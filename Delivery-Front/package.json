{
  "name": "Grocery Delivery",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev:app": "vite",
    "dev:tailwind": "tailwindcss -i src/styles/index.css -o ./public/styles/index.css --watch",
    "dev": "concurrently \"npm run dev:app\" \"npm run dev:tailwind\"",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "jsx:test": "xss-scan"
  },
  "devDependencies": {
    "@types/alpinejs": "^3.13.11",
    "autoprefixer": "^10.5.4",
    "concurrently": "^9.1.2",
    "esbuild": "^0.25.2",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.3",
    "vite": "^6.2.0"
  },
  "dependencies": {
    "@alpinejs/collapse": "^3.14.9",
    "@alpinejs/focus": "^3.14.9",
    "@iconify-json/ri": "^1.2.5",
    "@iconify/utils": "^2.3.0",
    "@kitajs/html": "^4.2.7",
    "@kitajs/ts-html-plugin": "^4.1.1",
    "alpinejs": "^3.14.9",
    "alpinejs-manage": "^1.0.4",
    "clsx": "^2.1.1",
    "react-hot-toast": "^2.6.0",
    "react-router-dom": "^7.18.2"
  }
}
